# ----- Server -----
SERVER_PORT=8080

# ----- MongoDB -----
# Local: mongodb://localhost:27017/faruk_fashion
# Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/faruk_fashion
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/faruk_fashion

# ----- JWT -----
JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-bytes-for-hs512
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ----- Gmail SMTP (OTP, order emails) -----
# App Password: Google Account → Security → 2-Step → App passwords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# ----- Razorpay (payments) -----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ----- Twilio (WhatsApp / SMS) – optional -----
# From numbers = Twilio numbers, NOT your personal +91 phone
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+14155238886

# ----- App -----
FRONTEND_URL=http://localhost:3000
SELLER_EMAIL=orders@farukfashion.com
UPLOAD_DIR=uploads
SUPPORT_EMAIL=support@farukfashion.com
SUPPORT_PHONE=+91 93442 82751
ADMIN_PHONE=+91 93442 82751

# ----- Frontend (Vite) – optional in frontend/.env -----
# VITE_API_BASE_URL=http://localhost:8080/api